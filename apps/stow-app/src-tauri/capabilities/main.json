{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window: every app command plus the plugins the library UI uses",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME/Library/Application Support/Stow/attachments/**"
        },
        {
          "path": "$HOME/Library/Application Support/Stow"
        }
      ]
    },
    "dialog:default",
    "notification:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "autostart:default",
    "allow-add-attachment",
    "allow-add-item",
    "allow-add-reminder",
    "allow-add-task",
    "allow-app-info",
    "allow-backup-database",
    "allow-capture-front-tab",
    "allow-capture-settings",
    "allow-close-front-tab",
    "allow-create-bucket",
    "allow-delete-api-key",
    "allow-delete-attachment",
    "allow-delete-bucket",
    "allow-delete-item",
    "allow-delete-recording",
    "allow-delete-reminder",
    "allow-delete-task",
    "allow-delete-whisper-models",
    "allow-download-whisper-model",
    "allow-export-library",
    "allow-get-item",
    "allow-get-settings",
    "allow-get-task",
    "allow-has-api-key",
    "allow-hide-capture",
    "allow-import-chrome-tabs",
    "allow-is-recording",
    "allow-list-ai-runs",
    "allow-list-attachments",
    "allow-list-buckets",
    "allow-list-chrome-tabs",
    "allow-list-items",
    "allow-list-recordings",
    "allow-list-reminders",
    "allow-list-tasks",
    "allow-move-item",
    "allow-open-attachment",
    "allow-open-privacy-settings",
    "allow-pairing-code",
    "allow-permission-status",
    "allow-read-snapshot",
    "allow-ready-to-quit",
    "allow-refetch-item",
    "allow-reminder-agenda",
    "allow-rename-task",
    "allow-reorder-buckets",
    "allow-request-automation",
    "allow-request-microphone",
    "allow-reset-all-data",
    "allow-respond-pair",
    "allow-retranscribe",
    "allow-reveal-data-dir",
    "allow-rotate-extension-token",
    "allow-run-ai",
    "allow-search",
    "allow-set-api-key",
    "allow-set-close-tab-after-capture",
    "allow-set-item-done",
    "allow-show-main",
    "allow-snooze-reminder",
    "allow-start-recording",
    "allow-stop-recording",
    "allow-toggle-task",
    "allow-update-bucket",
    "allow-update-item-notes",
    "allow-update-settings",
    "allow-whisper-model-downloaded"
  ]
}
