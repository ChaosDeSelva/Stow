{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stow",
  "version": "0.1.0",
  "identifier": "io.github.chaosdeselva.stow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Stow",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600
      },
      {
        "label": "capture",
        "title": "Quick Capture",
        "url": "index.html#/capture",
        "width": 520,
        "height": 320,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "center": true,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src 'none'; object-src 'none'; form-action 'none'; base-uri 'none'",
      "devCsp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src 'none'; object-src 'none'; form-action 'none'; base-uri 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/Library/Application Support/Stow/assets/**",
          "$HOME/Library/Application Support/Stow/audio/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "./Entitlements.plist"
    },
    "resources": {
      "../../../extension/*.js": "extension/",
      "../../../extension/*.json": "extension/",
      "../../../extension/*.html": "extension/",
      "../../../extension/icons/": "extension/icons/",
      "../../../THIRD_PARTY_*.md": "",
      "../../../LICENSE-MIT": "",
      "../../../LICENSE-APACHE": ""
    }
  }
}
